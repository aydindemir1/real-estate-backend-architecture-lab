      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('userId')) pm.collectionVariables.set('userId', pm.variables.replaceIn('{{$guid}}'));",
          "if (!pm.collectionVariables.get('missingSellerId')) pm.collectionVariables.set('missingSellerId', pm.variables.replaceIn('{{$guid}}'));",
          "if (!pm.collectionVariables.get('missingSubmissionId')) pm.collectionVariables.set('missingSubmissionId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
