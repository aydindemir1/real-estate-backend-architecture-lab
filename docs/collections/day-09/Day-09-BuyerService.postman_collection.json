{
  "info": {
    "_postman_id": "0e0c335a-7d82-4f06-8c36-6ef45c54d909",
    "name": "Day 09 - BuyerService Couchbase Hexagonal",
    "description": "Local runtime acceptance: success and error scenarios for BuyerService.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9093"
    },
    {
      "key": "buyerId",
      "value": ""
    },
    {
      "key": "missingBuyerId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('buyerId')) {",
          "  pm.collectionVariables.set('buyerId', pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "if (!pm.collectionVariables.get('missingBuyerId')) {",
          "  pm.collectionVariables.set('missingBuyerId', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Success Scenarios",
      "item": [
        {
          "name": "01 - PUT Preferences - 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "postman-day09-{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/buyers/{{buyerId}}/preferences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "buyers",
                "{{buyerId}}",
                "preferences"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minPrice\": 1000000,\n  \"maxPrice\": 5000000,\n  \"currency\": \"TRY\",\n  \"preferredLocations\": [\n    {\n      \"city\": \"Istanbul\",\n      \"district\": \"Kadikoy\"\n    }\n  ],\n  \"propertyTypes\": [\n    \"APARTMENT\"\n  ],\n  \"minRooms\": 1,\n  \"maxRooms\": 3,\n  \"minArea\": 70,\n  \"maxArea\": 140,\n  \"preferredFeatures\": [\n    \"BALCONY\"\n  ],\n  \"notificationSettings\": {\n    \"emailEnabled\": true,\n    \"pushEnabled\": false,\n    \"smsEnabled\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('buyerId matches', () => pm.expect(body.buyerId).to.eql(pm.collectionVariables.get('buyerId')));",
                  "pm.test('currency is TRY', () => pm.expect(body.priceRange.currency).to.eql('TRY'));"
                ]
              }
            }
          ]
        },
        {
