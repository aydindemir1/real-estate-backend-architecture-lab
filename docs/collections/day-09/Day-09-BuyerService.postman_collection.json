                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('buyerId matches', () => pm.expect(body.buyerId).to.eql(pm.collectionVariables.get('buyerId')));",
                  "pm.test('saved search added', () => pm.expect(body.savedSearches.length).to.be.above(0));"
                ]
              }
