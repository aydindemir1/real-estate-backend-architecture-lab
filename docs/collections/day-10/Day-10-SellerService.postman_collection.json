                "listing-submissions"
              ],
              "query": [
                {
                  "key": "yearMonth",
                  "value": "{{yearMonth}}"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Items exist', () => pm.expect(body.items.length).to.be.above(0));",
                  "pm.test('Created submission is listed', () => pm.expect(body.items.map(x => x.submissionId)).to.include(pm.collectionVariables.get('submissionId')));"
                ]
              }
            }
          ],
          "response": []
        },
