        {
          "name": "register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"aydin\",\n  \"email\": \"aydin@example.com\",\n  \"password\": \"123456\",\n  \"rePassword\": \"123456\"\n}"
            },
            "url": "{{authBaseUrl}}/auth/register"
          }
        },
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"aydin\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{authBaseUrl}}/auth/login"
          }
        },
        {"name": "findAll", "request": {"method": "GET", "url": "{{authBaseUrl}}/auth/findAll?token={{token}}"}},
        {"name": "getMessage", "request": {"method": "GET", "url": "{{authBaseUrl}}/auth/getMessage"}}
