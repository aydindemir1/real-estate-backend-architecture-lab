              "path": [
                "sellers",
                "{{sellerId}}",
                "listing-submissions",
                "{{submissionId}}",
                "submit"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Listing is SUBMITTED', () => pm.expect(body.status).to.eql('SUBMITTED'));",
                  "pm.test('submissionId matches', () => pm.expect(body.submissionId).to.eql(pm.collectionVariables.get('submissionId')));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "06 - GET List After Submit - 200",
          "request": {
            "method": "GET",
            "header": [
              {
