                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sellers/{{sellerId}}/listing-submissions?yearMonth={{yearMonth}}&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sellers",
                "{{sellerId}}",
                "listing-submissions"
              ],
              "query": [
                {
                  "key": "yearMonth",
                  "value": "{{yearMonth}}"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const item = body.items.find(x => x.submissionId === pm.collectionVariables.get('submissionId'));",
                  "pm.test('Submitted listing persisted', () => pm.expect(item && item.status).to.eql('SUBMITTED'));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
