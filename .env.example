# Local development template
# Copy this file to .env and replace every CHANGE_ME value.
# .env is ignored by Git.

# Spring Cloud / Eureka
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# AuthService - PostgreSQL
AUTH_DB_NAME=micro_auth_service_db
AUTH_DB_URL=jdbc:postgresql://localhost:5433/micro_auth_service_db
AUTH_DB_USERNAME=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME

# UserProfileService - PostgreSQL
USER_PROFILE_DB_NAME=micro_user_profile_service_db
USER_PROFILE_DB_URL=jdbc:postgresql://localhost:5434/micro_user_profile_service_db
USER_PROFILE_DB_USERNAME=CHANGE_ME
USER_PROFILE_DB_PASSWORD=CHANGE_ME

# AgentService - MySQL
AGENT_DB_NAME=micro_agent_service_db
AGENT_DB_URL=jdbc:mysql://localhost:3307/micro_agent_service_db
AGENT_DB_USERNAME=CHANGE_ME
AGENT_DB_PASSWORD=CHANGE_ME
AGENT_DB_ROOT_PASSWORD=CHANGE_ME

# BuyerService - Couchbase
BUYER_DB_NAME=micro_buyer_service_db
BUYER_DB_USERNAME=CHANGE_ME
BUYER_DB_PASSWORD=CHANGE_ME
COUCHBASE_ADMIN_USERNAME=CHANGE_ME
COUCHBASE_ADMIN_PASSWORD=CHANGE_ME
BUYER_COUCHBASE_CONNECTION_STRING=couchbase://localhost
BUYER_COUCHBASE_BUCKET=buyer
BUYER_COUCHBASE_SCOPE=buyer_service
BUYER_COUCHBASE_COLLECTION=preferences
BUYER_COUCHBASE_KV_TIMEOUT=2500ms
BUYER_COUCHBASE_QUERY_TIMEOUT=75s

# PropertyService - PostgreSQL (current service config)
PROPERTY_DB_NAME=micro_property_service_db
PROPERTY_DB_URL=jdbc:postgresql://localhost:5437/micro_property_service_db
PROPERTY_DB_USERNAME=CHANGE_ME
PROPERTY_DB_PASSWORD=CHANGE_ME

# Property MongoDB container variables (planned/current Docker profile)
PROPERTY_MONGO_DB_NAME=micro_property_service_db
PROPERTY_MONGO_ROOT_USERNAME=CHANGE_ME
PROPERTY_MONGO_ROOT_PASSWORD=CHANGE_ME

# SellerService - Cassandra
SELLER_CASSANDRA_CONTACT_POINTS=localhost
SELLER_CASSANDRA_PORT=9042
SELLER_CASSANDRA_KEYSPACE=seller_service
SELLER_CASSANDRA_LOCAL_DATACENTER=datacenter1
SELLER_CASSANDRA_USERNAME=
SELLER_CASSANDRA_PASSWORD=
SELLER_CASSANDRA_REQUEST_TIMEOUT=5s

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# Auth/JWT
AUTH_JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
AUTH_JWT_ISSUER=java-44-auth-service
AUTH_JWT_EXPIRE_MS=300000
