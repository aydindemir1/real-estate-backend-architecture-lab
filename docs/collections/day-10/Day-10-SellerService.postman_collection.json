  "item": [
    {
      "name": "01 - Success Scenarios",
      "item": [
        {
          "name": "01 - POST Create Seller - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"displayName\": \"Aydın Demir\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sellers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sellers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Seller is ACTIVE', () => pm.expect(body.status).to.eql('ACTIVE'));",
                  "pm.test('userId matches', () => pm.expect(body.userId).to.eql(pm.collectionVariables.get('userId')));",
                  "pm.collectionVariables.set('sellerId', body.sellerId);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 - GET Seller - 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sellers/{{sellerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sellers",
                "{{sellerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('sellerId matches', () => pm.expect(body.sellerId).to.eql(pm.collectionVariables.get('sellerId')));",
                  "pm.test('Seller is ACTIVE', () => pm.expect(body.status).to.eql('ACTIVE'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 - POST Create Listing Submission - 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Gebze Merkez Daire\",\n  \"description\": \"Day 10 runtime acceptance listing\",\n  \"propertyType\": \"APARTMENT\",\n  \"city\": \"Kocaeli\",\n  \"district\": \"Gebze\",\n  \"addressLine\": \"Örnek Mah. No:1\",\n  \"priceAmount\": 3500000,\n  \"currency\": \"TRY\",\n  \"area\": 120,\n  \"roomCount\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/sellers/{{sellerId}}/listing-submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sellers",
                "{{sellerId}}",
                "listing-submissions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Listing is CREATED', () => pm.expect(body.status).to.eql('CREATED'));",
                  "pm.test('sellerId matches', () => pm.expect(body.sellerId).to.eql(pm.collectionVariables.get('sellerId')));",
                  "pm.collectionVariables.set('submissionId', body.submissionId);",
                  "pm.collectionVariables.set('createdAt', body.createdAt);",
                  "pm.collectionVariables.set('yearMonth', body.createdAt.substring(0, 7));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "04 - GET List Seller Submissions - 200",
          "request": {
            "method": "GET",
            "header": [
